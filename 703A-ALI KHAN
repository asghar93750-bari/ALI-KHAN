#include <iostream>
using namespace std;
int main (){
    int x{};
    cin>>x;
    int c_count=0;
    int m_count=0;
    while(x--){
        int c{},m{};
        cin>>c>>m;
        if(c>m){
            c_count++;
        }
        else if(m>c){
            m_count++;
        }
    }
    if(c_count>m_count){
        cout<<"Mishka"<<endl;
    }else if(m_count>c_count){
        cout<<"Chris"<<endl;
    }else if(c_count==m_count){
        cout<<"Friendship is magic!^^"<<endl;
    }
    return 0;
};
